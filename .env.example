# Copy to ai-career-forge-backend/.env.development and supply your own values.
# Never commit that file. See docs/SETUP.md.
MONGODB_URI=mongodb://localhost:27017/zenith
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-strong-random-signing-secret
JWT_EXPIRATION=86400000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-private-development-bucket
SPRING_AI_OPENAI_CHAT_BASE_URL=https://integrate.api.nvidia.com
