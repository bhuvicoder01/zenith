SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=meta/llama-3.1-70b-instruct
SPRING_AI_OPENAI_EMBEDDING_BASE_URL=
SPRING_AI_OPENAI_EMBEDDING_API_KEY=
SPRING_AI_OPENAI_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
GOOGLE_AI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
RAPIDAPI_KEY=
USAJOBS_API_KEY=NOT_CONFIGURED
USAJOBS_EMAIL=NOT_CONFIGURED
LOGO_DEV_TOKEN=
BRANDFETCH_TOKEN=
