MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/aicareerforge
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
JWT_SECRET=8a3c9b7d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d

# SMTP Configuration (Example for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password # Use Gmail App Password, not your regular password

# Resend API Configuration (Requires custom domain)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# SendGrid Configuration (Recommended for using your personal Gmail)
SENDGRID_API_KEY=SG.your_api_key
SENDGRID_FROM_EMAIL=your-verified-gmail@gmail.com

# NVIDIA NIM AI Configuration
SPRING_AI_OPENAI_CHAT_BASE_URL=https://integrate.api.nvidia.com
SPRING_AI_OPENAI_CHAT_API_KEY=nvapi-your_nvidia_api_key
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=meta/llama-3.1-70b-instruct

# Optional: Custom embedding keys (falls back to chat configurations if left blank)
SPRING_AI_OPENAI_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com
SPRING_AI_OPENAI_EMBEDDING_API_KEY=nvapi-your_nvidia_api_key
SPRING_AI_OPENAI_EMBEDDING_MODEL=nvidia/embeddings-nv-embed-qa-4
